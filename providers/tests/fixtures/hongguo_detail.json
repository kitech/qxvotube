txWs", "scheme_params": {"gd_label": "click_schema_lhft_74639668a", "needlaunchlog": 1, "ug_attr_lxft": "75198209a"}}, "android": {"link": "https://novel8662.ugurl.cn/F1Lc5", "fallback": "https://novel8662.ugurl.cn/F1Lc5", "scheme_params": {"gd_label": "click_schema_lhft_74639644a", "needlaunchlog": 1, "ug_attr_lxft": "75198724a"}}, "pc_ios": {"link": "https://novel8662.ugurl.cn/FSd87", "fallback": "https://novel8662.ugurl.cn/FSd87", "scheme_params": {"gd_label": "click_schema_lhft_76221147a", "needlaunchlog": 1, "ug_attr_lxft": "76221146a"}}, "pc_and": {"link": "https://novel8662.ugurl.cn/FSd87", "fallback": "https://novel8662.ugurl.cn/FSd87", "scheme_params": {"gd_label": "click_schema_lhft_76221149a", "needlaunchlog": 1, "ug_attr_lxft": "76221148a"}}}}]}]}, "homeFeedEnabled": true, "homeFeedBrowserAllowed": true, "pcLoginProfile": null, "libraConfig": {"drama_card_destination_pc": {}, "m_dialog_type": {"val": "normal"}, "m_dialog_showtime": {"val": "after"}, "is_need_report_fuzzy_guanwang": {"val": true}, "visible_episode_cnt": {"val": 5}, "pc_watch_access": {"val": {"locked_episode_action": "web"}}}, "isSuccess": true}, "recommendations": {}, "seriesDetail": {"episode_cnt": 100, "accessible_episode_cnt": 5, "pay_type": 0, "series_id": "7671966197985856536", "series_name": "持械入宋：第一季", "series_cover": "https://p3-novel.byteimg.com/novel-pic/3edbd9c6ab15ebff3fd0853ec74a4f27~tplv-shrink:640:0.image", "series_intro": "宋末年，烽火连天。一支执行任务的现代五人小队，意外坠入时空隧道，全员携械穿越到大宋。队长林昭京片子冷静果决，统帅全局。狙击手谢长风、军械师马振邦-一口东北大碴子，战力拉满。通信兵王浩川-广东仔，情报组网，眼观六路。湘妹子医官陈素--妙手回春，战地玫瑰。以现代人的视角看大宋，这将是一场现代与古代的文化冲突，将是一场科技的降维碾压。大宋注定将不再平凡。", "tags": ["脑洞", "穿越", "古代"], "episode_right_text": "全100集", "celebrities": [], "series_episode_info": {"episode_cnt": 100, "episode_total_cnt": 100, "series_status": 1}, "vid_list": ["7671977925326949400", "7671977933363235864", "7671977930024553496"], "first_visible_time": "1787306284", "season_info": {"series_group_id": "7676739369444576281"}, "record_number": "（番茄）网微剧备字（2026）第736872号"}, "seriesSocialInfo": {"rating": 9.5, "series_like_count": "6133000", "series_favorite_count": "5103000", "rating_count": "18814", "rank_label": "AI剧收藏榜第2名", "hot_score_data": {"score": 59979812, "text": "5997万热度"}, "reviews": {"total_count": "2413", "reviews": [{"create_time": "1791538001", "digg_count": "579", "rating": 10, "user_name": "瑾叶剧场", "user_avatar": "http://p3-reading-sign.fqnovelpic.com/tos-cn-i-1yzifmftcy/630fe1d5b143491aa6cd1939629a2821~tplv-s85hriknmn-jpeg-v1:144:0.jpeg?lk3s=9b9bd2b1&x-expires=1797265256&x-signature=n9jz1XqZr2PxCZI9Az0SuJXP4zI%3D", "content": "《持械入宋：第一季》\n这是一个没有系统外挂的穿越故事。\n现代特战五人小队，骤然坠落到风雨飘摇的王朝末年。\n落地即是乱世，危机四伏。故事从西北边地清河村开始，身份是摆在所有人面前的第一道难题。五人小队帮助清河村民一起对抗外敌，用现代技术解决生存问题。\n感恩大家陪伴我们开启这段跨越千年的艰难旅程，正是第一季的种种伏笔，铺就了后面的故事！"}, {"create_time": "1790428710", "digg_count": "87", "rating": 10, "user_name": "华崽俚不卖爺田", "user_avatar": "https://p3.douyinpic.com/aweme/1080x1080/aweme-avatar/tos-cn-i-0813_cded68d451584f31b4b1eebfce6b564b.jpeg?from=3782654143", "content": "一、穿越剧太多，雷同的不少，但这部剧我打五星⭐。\n二、五位穿越的主角个性分明，人物刻画丰满。男主林昭，果敢、敏锐、思虑周全，胆大心细，杀伐果断，具有领导力。\n三、谢长风，有趣、行动力强，能力出众，敢爱敢恨。\n四、陈素神医娘子，侠义善良，善医善思。\n五、王浩川，能文能武，机敏应变，不迂腐，不循旧。\n六、大哥马振邦，胸有城府，动手能力极强，很有担当。\n整个剧集跌宕起伏，引入入局。[笑]"}, {"create_time": "1788266519", "digg_count": "112", "rating": 10, "user_name": "万花栗子", "user_avatar": "https://p3-novel.byteimg.com/img/novel-static/8b91e01a7b0242389b43128fe854e4b7~tplv-1yzifmftcy-expand:200:0:0.png", "content": "男主收下秦红缨那段太诡异了…其他地方都不错。剧情节奏不拖沓，画面精美，人物形象鲜明。男主林昭不是个吃亏的主，路见不平他有能力摆平，快意恩仇睚眦必报，是个降血压的爽剧[赞]"}]}}, "isSuccess": true}}, "errors": null}